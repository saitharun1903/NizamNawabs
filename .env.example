# ==========================================================
# NIZAM NAWABS PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================================

1 DATABASE CONFIGURATION (Server-Only Secret)
# PostgreSQL connection string for Vercel Production (Supabase / Neon / Vercel Postgres)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/nizam_nawabs?sslmode=require"

# 2. AUTHENTICATION (Server-Only Secret)
# Cryptographic secret used to sign and verify Admin JWT session cookies
JWT_SECRET="generate-a-strong-random-64-character-secret-for-production"

# 3. MEDIA STORAGE (Server-Only Secret - Optional for Vercel Blob)
# Automatically populated by Vercel when connecting Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=""

# 4. PUBLIC SITEURL  (Public Client & Server)
# Canonical production URL (used for SEO metadata, Open Graph, Sitemap & Robots)
# Update to your custom GoDaddy domain once active (e.g., https://www.nizamnawabs.com)
NEXT_PUBLIC_SITE_URL="https://www.nizamnawabs.com"
